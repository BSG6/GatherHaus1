
<%- include('../partials/header') -%>
<%- include('../partials/header') -%>

<div class="ml-64 min-h-screen bg-white">
    <main class="max-w-6xl mx-auto py-10 px-6 space-y-10">

        <!-- Header -->
        <h1 class="text-4xl font-extrabold text-[#7E5DFA] border-b border-[#C1C1C1] pb-4">
        Find Collaborators
        </h1>
        <p class="text-gray-700 max-w-2xl text-sm">
        Connect with creators who are open to collaboration. Use this space to explore crafts and build together.
        </p>

        <!-- Creator Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% creators.forEach(creator => { %>
            <% if (creator.readyToCollab) { %>
            <div class="bg-white border border-[#C1C1C1] rounded-lg shadow-sm p-6 space-y-3">

                <h3 class="text-xl font-bold text-[#000000]"><%= creator.name %></h3>

                <% if (creator.bio) { %>
                <p class="text-sm text-gray-600"><%= creator.bio.substring(0, 100) %>...</p>
                <% } %>

                <p class="text-sm text-[#1F1F1F]"><strong>Craft:</strong> <%= creator.craft || "N/A" %></p>
                <p class="text-sm text-[#1F1F1F]"><strong>Location:</strong> <%= creator.location || "N/A" %></p>

                <span class="inline-block text-xs font-semibold text-[#7E5DFA] bg-[#F3F0FF] px-2 py-1 rounded-full">
                Open to Collaborate
                </span>

                <a href="/creator/<%= creator.name %>"
                class="inline-block mt-4 border-2 border-[#7E5DFA] text-[#1F1F1F] font-bold hover:bg-[#7E5DFA] hover:text-white px-4 py-2 rounded-md transition-all duration-200">
                View Profile
                </a>

            </div>
            <% } %>
        <% }) %>
        </div>

    </main>
</div>

<%- include('../partials/footer') -%>



<%- include('../partials/footer') -%>

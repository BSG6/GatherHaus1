<%- include('../partials/header') -%>
    <main class="min-h-screen p-8 bg-gradient-to-b from-[#F6F3FF] to-[#FFFFFF] py-10 px-6">
        <div class="max-w-4xl mx-auto space-y-10">
    
        <!-- Header -->
        <section class="text-center">
            <h1 class="text-4xl font-extrabold text-[#7E5DFA]" style="text-shadow: 1px 1px #C1C1C1;">
            Welcome, <%= user.userName %>
            </h1>
            <p class="text-[#1F1F1F] text-lg mt-2"><%= creator.bio || "Tell us about yourself!" %></p>
        </section>
    
        <!-- Image Upload Section -->
        <section class="bg-[#F9F9F9] border border-[#C1C1C1] rounded-lg p-6 shadow-sm">
            <h2 class="text-2xl font-semibold text-[#1F1F1F] mb-4">Profile Photo</h2>
            <%- include('../partials/imageUpload', { formAction: '/creator/imageUpload' }) %>
        </section>
    
        <!-- Edit Form -->
        <section class="bg-[#F9F9F9] border border-[#C1C1C1] rounded-lg p-8 shadow-md space-y-6">
            <h2 class="text-2xl font-bold text-[#1F1F1F]">Edit Your Profile</h2>
    
            <form action="/creator/edit?_method=PUT" method="POST" class="space-y-5">
    
            <!-- Bio -->
            <div>
                <label for="bio" class="block hover:rotate-3 font-medium text-[#1F1F1F] mb-1">📝 Bio</label>
                <input type="text" name="bio" value="<%= creator.bio %>" placeholder="Enter your bio"
                    class="w-full px-4 py-2 border border-[#C1C1C1] rounded-md focus:ring-2 focus:ring-[#7E5DFA] focus:outline-none" />
            </div>
    
            <!-- Location -->
            <div>
                <label for="location" class="block hover:rotate-3 font-medium text-[#1F1F1F] mb-1">📍 Location</label>
                <input type="text" name="location" value="<%= creator.location %>"
                    class="w-full px-4 py-2 border border-[#C1C1C1] rounded-md focus:ring-2 focus:ring-[#7E5DFA]" />
            </div>
    
            <!-- Craft Dropdown -->
            <div>
                <label for="craft" class="block hover:rotate-3 font-medium text-[#1F1F1F] mb-1">🎨 What do you create?</label>
                <select name="craft" id="craft" required
                        class="w-full px-4 py-2 border border-[#C1C1C1] rounded-md bg-white focus:ring-2 focus:ring-[#7E5DFA]">
                <% craftOptions.forEach(option => { %>
                    <option value="<%= option %>" <%= creator.craft === option ? "selected" : "" %>><%= option %></option>
                <% }); %>
                </select>
            </div>
    
            <!-- Social Links -->
            <div class="grid md:grid-cols-2 gap-4">
                <div>
                <label class="block hover:rotate-3 font-medium text-[#1F1F1F] mb-1">📸 Instagram</label>
                <input type="text" name="instagram" value="<%= creator.instagram %>"
                        class="w-full px-4 py-2 border border-[#C1C1C1] rounded-md focus:ring-2 focus:ring-[#7E5DFA]" />
                </div>
                <div>
                <label class="block hover:rotate-3 font-medium text-[#1F1F1F] mb-1">🎵 TikTok</label>
                <input type="text" name="tiktok" value="<%= creator.tiktok %>"
                        class="w-full px-4 py-2 border border-[#C1C1C1] rounded-md focus:ring-2 focus:ring-[#7E5DFA]" />
                </div>
                <div class="md:col-span-2">
                <label class="block hover:rotate-3 font-medium text-[#1F1F1F] mb-1">🌐 Website</label>
                <input type="text" name="website" value="<%= creator.website %>"
                        class="w-full px-4 py-2 border border-[#C1C1C1] rounded-md focus:ring-2 focus:ring-[#7E5DFA]" />
                </div>
            </div>
    
            <!-- Collab & Contact -->
            <div class="space-y-2">
                <label class="flex items-center space-x-2">
                <input type="checkbox" name="readyToCollab" value="true"
                        <%= creator.readyToCollab ? 'checked' : '' %>
                        class="h-4 w-4 text-[#7E5DFA] border-gray-300 rounded" />
                <span class="font-medium text-[#1F1F1F]">Open to Collaboration</span>
                </label>
    
                <label class="block  font-medium text-[#1F1F1F] mb-1 mt-2">💬 Best Way to Reach You</label>
                <input type="text" name="collabMethod" value="<%= creator.collabMethod %>"
                    class="w-full px-4 py-2 border border-[#C1C1C1] rounded-md focus:ring-2 focus:ring-[#7E5DFA]" />
            </div>
    
            <!-- Submit Button -->
            <button type="submit"
                    class="w-full bg-[#7E5DFA] text-white font-bold py-3 rounded-md mt-4 shadow-md
                            hover:bg-[#6844e0] hover:scale-105 transition-all duration-300">
                ✅ Update Profile
            </button>
    
            </form>
        </section>
        </div>
    </main>
    
<%- include('../partials/footer') -%>
<main class="bg-white p-6">
    <section class="max-w-5xl mx-auto space-y-6">
    
        <!-- Header -->
        <h2 class="text-3xl font-extrabold text-[#7E5DFA] border-b border-[#C1C1C1] pb-2" style="text-shadow: 1px 1px #C1C1C1;">
            📅 Upcoming Events
        </h2>
    
        <!-- Events -->
        <% if (events && events.length > 0) { %>
            <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            <% events.forEach(event => { %>
                <div class="bg-[#F9F9F9] border border-[#C1C1C1] rounded-lg shadow-sm p-5 hover:shadow-md hover:scale-[1.01] transition-all duration-200 space-y-2">
                
                <h3 class="text-xl font-bold text-[#1F1F1F] tracking-wide"><%= event.title %></h3>
                
                <p class="text-sm text-[#1F1F1F]"><strong>Date:</strong> <%= new Date(event.date).toLocaleDateString() %></p>
                <p class="text-sm text-[#1F1F1F]"><strong>Location:</strong> <%= event.location %></p>
                <p class="text-sm text-gray-700"><%= event.description %></p>
    
                <% if (event.link) { %>
                    <a href="<%= event.link %>" target="_blank"
                    class="inline-block mt-2 text-sm text-[#7E5DFA] font-semibold hover:underline">
                    🔗 More Info
                    </a>
                <% } %>
                </div>
            <% }) %>
            </div>
        <% } else { %>
            <p class="text-[#1F1F1F] italic">No upcoming events yet. Time to plan something beautiful 🌼</p>
        <% } %>
    
        <!-- Browse Events Button -->
        <div>
            <a href="/events"
            class="inline-block mt-4 border-2 border-[#7E5DFA] text-[#1F1F1F] font-bold hover:bg-[#7E5DFA] hover:text-white px-5 py-2 rounded-md transition-all duration-200">
            🔍 Browse All Events
            </a>
        </div>
    
    </section>
</main>
    



<!-- when using the partial in ejs you can override what is being called BEESTING -include("../partials/displayEvent", {here you add what you want to call, in this case it would be . events}) -->
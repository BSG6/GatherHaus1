<!DOCTYPE html>
<html   lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gather Haus</title>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.fixed4.0/css/all.min.css"
    />
    <script src="https://cdn.tailwindcss.com"></script>
    
 
    <link rel="stylesheet" href="/output.css" />

    <link rel="stylesheet" href="/css/style.css" />
    <!-- <link rel="stylesheet" href="public/css/app.css" /> -->
  </head>
  <body class="min-h-screen">
    <div class=" w-64 fixed top-0 left-0 bg-white border-r border-gray-300 flex flex-col justify-between shadow-sm z-50">
      <!-- Logo + Title -->
      <div class="p-6 flex flex-col items-center border-b border-gray-200">
        <a href="/" class="flex items-center gap-2">
          <img src="/imgs/Gather.png" alt="Gather Haus Logo" class="w-50 h-50 object-contain">
          <!-- <span class="text-2xl font-black text-[#8F4FFF] tracking-wide">Gather Haus</span> -->
        </a>
      </div>
      
      <!-- Navigation Links -->
      <nav class="flex-1 px-6 py-4 space-y-4 text-gray-700 font-medium text-base">
        <a href="/post/gatherBoard" class="block hover:text-black hover:font-bold transition duration-150">Gather Board</a>
        <a href="/creator/dashboard" class="block hover:text-black hover:font-bold transition duration-150">Dashboard</a>
        <a href="/creator/collab" class="block hover:text-black hover:font-bold transition duration-150">Collab</a>
        <a href="/events/add" class="block hover:text-black hover:font-bold transition duration-150">Add Event</a>
        <a href="/events" class="block hover:text-black hover:font-bold transition duration-150">Browse Events</a>
        <a href="/creator/edit" class="block hover:text-black hover:font-bold transition duration-150">Edit Profile</a>
      </nav>
      
      <!-- Logout Button -->
      <div class="p-6 border-t border-gray-200">
        <a href="/logout"
        class="block text-center border-2 border-black text-black font-bold hover:bg-black hover:text-white px-4 py-2 rounded-md transition-all duration-200">
        Logout
      </a>
    </div>
  </div>
  

        <div class="ml-64 min-h-screen bg-[#fafafa]">


        
  </body>
</html>

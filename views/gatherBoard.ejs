<%- include('partials/header') -%>

<section class="max-w-6xl mx-auto mt-10 px-4">
  <% if (messages.success) { %>
    <div class="bg-green-100 text-green-800 border border-green-300 px-4 py-2 rounded-md mb-6">
      <%= messages.success[0] %>
    </div>
  <% } %>
  <% if (messages.error) { %>
    <div class="bg-red-100 text-red-800 border border-red-300 px-4 py-2 rounded-md mb-6">
      <%= messages.error[0] %>
    </div>
  <% } %>

  <h1 class="text-5xl font-extrabold text-[#1F1F1F] mb-4" style="text-shadow: 1px 1px 0 #191919c3;">📌 Gather Board</h1>
  <p class="text-xl text-[#1F1F1F] font-semibold mb-6">Share and explore collaboration posts from the creator community.</p>

  <!-- Add Post Button -->
  <a href="/post/gatherBoardPost" class="inline-block border-4 border-[#7E5DFA] text-[#1F1F1F] font-bold hover:bg-[#1F1F1F] hover:text-white px-5 py-2 rounded-md shadow-sm transition-all duration-200 mb-10">
    + Add New Post
  </a>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <% posts.forEach(function(post) { %>
      <div id="post-<%= post._id %>" class="relative bg-[#F9F9F9] border border-[#C1C1C1] rounded-xl p-6 shadow-md hover:shadow-xl transition-all duration-300 hover:scale-[1.02] space-y-3">

        <!-- Purple top accent -->
        <div class="absolute top-0 left-0 h-2 w-full rounded-t-xl bg-[#7E5DFA]"></div>

        <!-- User -->
        <% if (post.user) { %>
          <a href="/creator/profile/<%= post.creatorId %>" class="text-[#7E5DFA] text-lg font-bold hover:underline hover:text-[#5FC4B6] block pt-2">
            <%= post.user.userName %>
          </a>
        <% } else { %>
          <span class="text-gray-400 italic block">Unknown user</span>
        <% } %>

        <!-- Title -->
        <h2 class="text-2xl font-bold text-[#1F1F1F]"><%= post.title %></h2>

        <!-- Caption -->
        <p class="text-[#1F1F1F] leading-relaxed"><%= post.caption %></p>

        <!-- Date -->
        <% if (post.createdAt) { %>
          <p class="text-sm text-gray-500"><%= new Date(post.createdAt).toLocaleDateString() %></p>
        <% } %>

        <!-- Toggle Comment Button -->
        <button
          type="button"
          class="text-sm text-[#7E5DFA] font-medium hover:underline"
          onclick="toggleComments('<%= post._id %>')"
        >
          💬 <%= post.comments?.length || 0 %> Comment<%= post.comments?.length === 1 ? "" : "s" %>
        </button>

        <!-- Comment Section -->
        <div id="comments-<%= post._id %>" class="hidden mt-4">
          <!-- Comment Form -->
          <form action="/comment/createComment/<%= post._id %>" method="POST" class="mb-4">
            <textarea name="commentText" placeholder="Leave a comment..." class="w-full border p-2 rounded" required></textarea>
            <button type="submit" class="bg-[#7E5DFA] text-white px-4 py-2 mt-2 rounded hover:bg-[#5FC4B6]">Submit</button>
          </form>

          <!-- Posted Comments -->
          <% if (post.comments && post.comments.length > 0) { %>
            <% post.comments.forEach(comment => { %>
              <div class="mb-2 border-b pb-1">
                <a href="/creator/profile/<%= comment.user._id %>" class="font-semibold text-[#7E5DFA] hover:underline">
                  <%= comment.user.userName %>
                </a>
                <p><%= comment.commentText %></p>
                <p class="text-xs text-gray-400"><%= new Date(comment.createdAt).toLocaleString() %></p>
              </div>
            <% }) %>
          <% } else { %>
            <p class="text-sm text-gray-500 italic">No comments yet.</p>
          <% } %>
        </div>
      </div>
    <% }) %>
  </div>
</section>

<script>
  function toggleComments(postId) {
    const section = document.getElementById(`comments-${postId}`);
    section.classList.toggle("hidden");
  }
</script>

<%- include('partials/footer') -%>
